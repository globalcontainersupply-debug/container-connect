{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "container-connect",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public (publishable) values only. Secrets such as SUPABASE_SERVICE_ROLE_KEY
  // must be added with: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  "vars": {
    "SUPABASE_PROJECT_ID":"hgsxmbxvclolstcektec"
"SUPABASE_PUBLISHABLE_KEY":"sb_publishable_Nig2z8hfUPGH8G6mpA--9w_lMAhXab4"
"SUPABASE_URL":"https://hgsxmbxvclolstcektec.supabase.co"
"VITE_SUPABASE_PROJECT_ID":"hgsxmbxvclolstcektec"
"VITE_SUPABASE_PUBLISHABLE_KEY":"sb_publishable_Nig2z8hfUPGH8G6mpA--9w_lMAhXab4"
"VITE_SUPABASE_URL":"https://hgsxmbxvclolstcektec.supabase.co"
  }
}
